meta {
  name: Health
  type: http
  seq: 1
}
get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}
tests {
  test("Should responder estado y fecha", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("ok");
    expect(res.body.checkedAt).to.match(/^\d{4}-\d{2}-\d{2}T/);
  });
}
