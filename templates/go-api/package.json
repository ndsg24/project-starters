{
  "name": "go-api",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "9.31.0",
    "eslint": "9.31.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "16.1.2",
    "prettier": "3.6.2",
    "typescript-eslint": "8.38.0",
    "jest": "29.7.0",
    "@types/jest": "29.5.14",
    "ts-jest": "29.2.6",
    "typescript": "5.8.3",
    "@types/node": "24.0.14",
    "@usebruno/cli": "4.2.0",
    "@stylistic/eslint-plugin": "5.10.0"
  },
  "scripts": {
    "prepare": "node tooling/prepare.mjs",
    "lint": "eslint . --max-warnings=0 && node tooling/go-format.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "go test -race ./...",
    "test:coverage": "go test -race -coverprofile=coverage.out ./...",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "bruno": "cd bruno && node ../node_modules/@usebruno/cli/bin/bru.js run --env local",
    "test:api": "node tooling/api-smoke.mjs",
    "dev": "go run ./cmd/api",
    "start": "./bin/api",
    "build": "go build -o bin/api ./cmd/api",
    "typecheck": "go vet ./...",
    "setup": "node tooling/setup.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:check": "go run ./cmd/database-check",
    "db:migrate": "node tooling/migrations.mjs up",
    "db:rollback": "node tooling/migrations.mjs down",
    "db:create": "node tooling/migrations.mjs create",
    "test:integration": "pnpm db:check",
    "docker:up": "docker compose --profile app up --build -d --wait",
    "docker:down": "docker compose --profile app down",
    "docker:logs": "docker compose --profile app logs -f"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "axios": "1.20.0",
      "@faker-js/faker": "10.6.0",
      "js-yaml@4": "4.3.2",
      "form-data@4": "4.0.6"
    }
  }
}
