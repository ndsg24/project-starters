{
  "name": "nest-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "node tooling/prepare.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "bruno": "cd bruno && node ../node_modules/@usebruno/cli/bin/bru.js run --env local",
    "test:api": "node tooling/api-smoke.mjs",
    "setup": "node tooling/setup.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:check": "node --import tsx tooling/database-check.mjs",
    "test:integration": "pnpm db:check",
    "postinstall": "prisma generate",
    "docker:up": "docker compose --profile app up --build -d --wait",
    "docker:down": "docker compose --profile app down",
    "docker:logs": "docker compose --profile app logs -f",
    "db:format": "prisma format"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@nestjs/cqrs": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "dotenv": "18.0.5",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "24.0.14",
    "@types/supertest": "^7.0.0",
    "eslint": "9.31.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "29.2.6",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "husky": "9.1.7",
    "lint-staged": "16.1.2",
    "@usebruno/cli": "4.2.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "prisma": "7.10.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.13.1",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "axios": "1.20.0",
      "@faker-js/faker": "10.6.0",
      "js-yaml@4": "4.3.2",
      "form-data@4": "4.0.6",
      "deepmerge-ts": "8.0.2",
      "mysql2": "3.24.5"
    }
  }
}
