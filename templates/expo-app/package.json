{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/manrope": "0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "^25.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^15.0.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "@tanstack/react-query": "5.104.0",
    "@react-native-community/netinfo": "12.0.1",
    "axios": "1.20.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "9.31.0",
    "@types/jest": "29.5.14",
    "@types/node": "24.0.14",
    "@types/react": "~19.2.2",
    "eslint": "9.31.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.3.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "16.1.2",
    "prettier": "3.6.2",
    "ts-jest": "29.2.6",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "@stylistic/eslint-plugin": "5.10.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "expo start",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform web",
    "prepare": "node tooling/prepare.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "build:native": "expo export --platform all --output-dir dist-native --max-workers 2",
    "setup": "node tooling/setup.mjs",
    "docker:up": "docker compose up --build -d --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.13.1",
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "xcode>uuid": "11.1.1",
      "decode-uri-component": "0.5.0"
    }
  }
}
